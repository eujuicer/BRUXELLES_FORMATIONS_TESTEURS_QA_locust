# Copier ce fichier en .env puis remplir les valeurs :
#   copy .env.example .env
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Adresse de l'API EventFlow testée
EVENTFLOW_HOST=http://localhost:8000

# Compte client (voir LOCUST_EXERCICES.md)
CLIENT_EMAIL=client@eventflow.test
CLIENT_PASSWORD=

# Compte organisateur (voir LOCUST_EXERCICES.md, exercice 7)
ORGA_EMAIL=orga@eventflow.test
ORGA_PASSWORD=

# Critère de réussite (exercice 9)
SEUIL_P95_MS=300
SEUIL_ECHECS=0.01
